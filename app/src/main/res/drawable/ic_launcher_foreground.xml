<?xml version="1.0" encoding="utf-8"?>
<!--
  Mealspire launcher foreground: a cream bowl with a fresh herb sprig and a
  spark of inspiration ("meal" + "inspire"). Everything stays inside the
  adaptive-icon safe zone (circle of radius 33 around 54,54 in the 108
  viewport), so no launcher mask clips the mark. The themed icon (Android 13+)
  uses the one-colour twin, ic_launcher_monochrome.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Herb sprig: a long leaf to the left, a short one to the right -->
    <path
        android:fillColor="#9BCB86"
        android:pathData="M53,50 C43.5,48.5 37.5,41 39.5,32.5 C48.5,33.5 54.5,40.5 53,50 Z" />
    <path
        android:fillColor="#7DB46A"
        android:pathData="M55,50 C61.5,47.8 64.8,42.6 63.6,37 C57.6,38 54,43.4 55,50 Z" />

    <!-- Spark -->
    <path
        android:fillColor="#FFD58A"
        android:pathData="M71,27 C71.6,31.4 72.6,32.4 77,33 C72.6,33.6 71.6,34.6 71,39 C70.4,34.6 69.4,33.6 65,33 C69.4,32.4 70.4,31.4 71,27 Z" />

    <!-- Rim: a capsule across the top of the bowl -->
    <path
        android:strokeColor="#FFF4E6"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M31.5,52 L76.5,52" />

    <!-- Bowl body: an exact half-circle below the rim -->
    <path
        android:fillColor="#FFF4E6"
        android:pathData="M31,55 A23,23 0 0 0 77,55 Z" />

    <!-- A warm band across the bowl -->
    <path
        android:strokeColor="#F3C9A6"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M37.5,63 L70.5,63" />

    <!-- Foot -->
    <path
        android:strokeColor="#FFF4E6"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M47,82.5 L61,82.5" />
</vector>
