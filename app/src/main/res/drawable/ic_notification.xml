<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar (small) notification icon: the Mealspire bowl, sprig and spark in
  pure white, because Android renders small icons from the alpha channel only.
  Tinted via Notification.setColor.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Sprig -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.6,10 C8.6,9.6 6.6,7.2 7.2,4.4 C10.2,4.8 12.1,7 11.6,10 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.4,10 C14.6,9.3 15.7,7.5 15.3,5.6 C13.3,5.9 12.1,7.8 12.4,10 Z" />

    <!-- Spark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.6,2.2 C18.8,3.7 19.2,4.1 20.7,4.3 C19.2,4.5 18.8,4.9 18.6,6.4 C18.4,4.9 18,4.5 16.5,4.3 C18,4.1 18.4,3.7 18.6,2.2 Z" />

    <!-- Rim -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M4.6,11.4 L19.4,11.4" />

    <!-- Bowl body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.4,12.6 A7.6,7.6 0 0 0 19.6,12.6 Z" />

    <!-- Foot -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M9.8,21.6 L14.2,21.6" />
</vector>
