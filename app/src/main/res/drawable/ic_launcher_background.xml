<?xml version="1.0" encoding="utf-8"?>
<!--
  Mealspire launcher background: deep terracotta with a soft light from the
  upper left, built from layered circles (no <gradient>: vectors support it
  only from API 24, the app ships with minSdk 23).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/ms_icon_base"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Light, upper-left -->
    <path
        android:fillColor="@color/ms_icon_glow"
        android:pathData="M30,26 m-74,0 a74,74 0 1,0 148,0 a74,74 0 1,0 -148,0" />
    <path
        android:fillColor="@color/ms_icon_glow_inner"
        android:pathData="M22,14 m-42,0 a42,42 0 1,0 84,0 a42,42 0 1,0 -84,0" />

    <!-- Shade, lower-right corner -->
    <path
        android:fillColor="@color/ms_icon_shade"
        android:pathData="M124,128 m-56,0 a56,56 0 1,0 112,0 a56,56 0 1,0 -112,0" />
</vector>
