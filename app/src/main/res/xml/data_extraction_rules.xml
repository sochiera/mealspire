<?xml version="1.0" encoding="utf-8"?>
<!-- Keep personal data and sign-in state within the current Android profile. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="mealspire_update_state.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="mealspire_update_state.xml" />
    </device-transfer>
</data-extraction-rules>
