<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: tokeny konta ChatGPT nie trafiają do chmury ani na inne urządzenie. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mealspire_chatgpt.xml" />
        <exclude domain="sharedpref" path="mealspire_backend.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mealspire_chatgpt.xml" />
        <exclude domain="sharedpref" path="mealspire_backend.xml" />
    </device-transfer>
</data-extraction-rules>
