<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/ms_background</item>
        <item name="android:navigationBarColor">@color/ms_background</item>
        <item name="android:windowBackground">@color/ms_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Terracotta accent, so dialogs, checkboxes, radio buttons and
             progress bars match the app palette instead of platform teal. -->
        <item name="android:colorPrimary">@color/ms_accent</item>
        <item name="android:colorPrimaryDark">@color/ms_accent_deep</item>
        <item name="android:colorAccent">@color/ms_accent</item>
        <item name="android:colorControlActivated">@color/ms_accent</item>
        <item name="android:colorControlHighlight">@color/ms_ripple</item>
        <item name="android:textColorPrimary">@color/ms_ink</item>
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog</item>
    </style>

    <!-- Every AlertDialog (Więcej, profil, logowanie…) gets the same rounded
         white sheet, ink text and terracotta buttons. -->
    <style name="AppTheme.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/ms_accent</item>
        <item name="android:colorControlActivated">@color/ms_accent</item>
        <item name="android:colorControlHighlight">@color/ms_ripple</item>
        <item name="android:textColorPrimary">@color/ms_ink</item>
        <item name="android:textColorSecondary">@color/ms_ink_body</item>
        <item name="android:buttonBarButtonStyle">@style/AppTheme.DialogButton</item>
    </style>

    <style name="AppTheme.DialogButton" parent="@android:style/Widget.Material.Light.Button.Borderless.Colored">
        <item name="android:textColor">@color/ms_accent_deep</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
