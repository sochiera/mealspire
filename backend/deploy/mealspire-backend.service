[Unit]
Description=Mealspire backend API v1 (isolated loopback)
After=network-online.target
Wants=network-online.target

[Service]
User=mealspire
Group=mealspire
WorkingDirectory=/opt/mealspire/current
Environment=JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
Environment=MEALSPIRE_PORT=18081
Environment=MEALSPIRE_CATALOG=/etc/mealspire/catalog.json
ExecStart=/opt/mealspire/current/bin/backend
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
